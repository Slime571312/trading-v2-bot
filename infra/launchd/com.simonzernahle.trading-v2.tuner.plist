<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.simonzernahle.trading-v2.tuner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/simonzernahle/trading-v2/infra/launchd/tuner-cron.sh</string>
    </array>

    <!-- Täglich 03:00 Uhr — Märkte ruhig, kein Performance-Impact auf den Bot -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/trading-v2-tuner.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/trading-v2-tuner.launchd.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
